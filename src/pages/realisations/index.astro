---
import { brand } from "../../config/brand";
import {
  sectorLabels,
  statusLabels,
  visualDirectionLabels,
} from "../../data/project-labels";
import { projects } from "../../data/projects";
import { localProjectPreviews } from "../../config/local-project-preview";
import BaseLayout from "../../layouts/BaseLayout.astro";

const publishedProjects = projects.filter((project) => project.published);
const availableSectors = [
  ...new Set(publishedProjects.map((project) => project.sector)),
];
---

<BaseLayout
  title={`Réalisations — ${brand.name}`}
  description="Galerie de créations web examinées et présentées avec leur véritable statut, leurs capacités et leurs limites."
>
  <div
    class="page-shell inner-page gallery-page"
    data-published-count={publishedProjects.length}
  >
    <header class="page-intro">
      <p class="section-kicker">Réalisations</p>
      <h1>Des créations à regarder de près.</h1>
      <p>
        Explorez des univers, des métiers et des façons de présenter une
        activité. Chaque fiche précise ce qui a été construit, ce que vous
        pouvez essayer et les limites du projet. Les concepts fictifs sont
        indiqués comme tels.
      </p>
    </header>
    {import.meta.env.DEV && localProjectPreviews.length > 0 && (
      <section
        class="local-project-preview"
        aria-labelledby="local-preview-title"
      >
        <h2 id="local-preview-title">Dans l’atelier : aperçu local</h2>
        <p>
          Ces brouillons sont visibles uniquement en développement. Ils ne font
          pas partie de la galerie publique.
        </p>
        <div class="project-grid">
          {localProjectPreviews.map(
            ({ project, captures, displayTitle, formatLabel }) => (
              <article class="project-card showcase-card">
                <div class="showcase-card-art">
                  <img
                    src={captures[0].src}
                    width={captures[0].width}
                    height={captures[0].height}
                    alt={captures[0].alt}
                  />
                  <span class="showcase-format">{formatLabel}</span>
                </div>
                <div>
                  <p class="project-meta">
                    {sectorLabels[project.sector]} ·{" "}
                    {statusLabels[project.status]}
                  </p>
                  <h3>{displayTitle}</h3>
                  <p>{project.summary}</p>
                  <p class="showcase-status">
                    Brouillon : aperçu local uniquement
                  </p>
                  <a
                    class="button button-primary"
                    href={`/atelier-local/realisations/${project.slug}/`}
                  >
                    Examiner la maquette
                  </a>
                </div>
              </article>
            ),
          )}
        </div>
      </section>
    )}
    {publishedProjects.length === 0 && localProjectPreviews.length === 0 ? (
      <section class="empty-gallery" aria-labelledby="empty-title">
        <span class="empty-symbol" aria-hidden="true">
          B
        </span>
        <div>
          <p class="section-kicker">Galerie en préparation</p>
          <h2 id="empty-title">
            Les premières fiches ne sont pas encore prêtes à être montrées.
          </h2>
          <p>
            Je vérifie les contenus, les droits des images, le rendu sur
            différents écrans et la qualité des démonstrations avant
            publication. Cette galerie s’enrichira progressivement, secteur par
            secteur.
          </p>
          <a class="text-link" href="/services/">
            En attendant, découvrir les services{" "}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    ) : (
      <div hidden={publishedProjects.length === 0}>
        <div class="gallery-filter" hidden>
          <label for="sector-filter">Filtrer par secteur</label>
          <select id="sector-filter" name="secteur">
            <option value="">Tous les secteurs</option>
            {availableSectors.map((sector) => (
              <option value={sector}>{sectorLabels[sector]}</option>
            ))}
          </select>
          <p id="filter-count" aria-live="polite"></p>
        </div>
        <div class="project-grid">
          {publishedProjects.map((project) => (
            <article class="project-card" data-sector={project.sector}>
              {project.previewAssets.slice(0, 1).map((asset) => (
                <img
                  src={asset.src}
                  width={asset.width}
                  height={asset.height}
                  alt={asset.alt}
                  loading="lazy"
                />
              ))}
              <div>
                <p class="project-meta">
                  {sectorLabels[project.sector]} ·{" "}
                  {statusLabels[project.status]}
                </p>
                <p class="project-direction">
                  Direction visuelle :{" "}
                  {visualDirectionLabels[project.visualDirection]}
                </p>
                <h2>{project.title}</h2>
                <p>{project.summary}</p>
                <a class="text-link" href={`/realisations/${project.slug}/`}>
                  Voir cette création <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLSelectElement>("#sector-filter");
  const filterPanel = document.querySelector<HTMLElement>(".gallery-filter");
  const cards = [
    ...document.querySelectorAll<HTMLElement>(".project-card[data-sector]"),
  ];
  const count = document.querySelector<HTMLElement>("#filter-count");

  if (filter && filterPanel && count) {
    filterPanel.hidden = false;
    const updateFilter = () => {
      let visibleCount = 0;

      for (const card of cards) {
        const visible = !filter.value || card.dataset.sector === filter.value;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      count.textContent = `${visibleCount} création${visibleCount > 1 ? "s" : ""} affichée${visibleCount > 1 ? "s" : ""}`;
    };

    filter.addEventListener("change", updateFilter);
    updateFilter();
  }
</script>
