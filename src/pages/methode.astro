---
import { brand } from "../config/brand";
import BaseLayout from "../layouts/BaseLayout.astro";

const phases = [
  {
    number: "01",
    title: "Comprendre et cadrer",
    description:
      "Nous parlons de votre activité, de vos objectifs et de vos contraintes. Une proposition écrite fixe ensuite le périmètre, les responsabilités et les conditions du projet.",
    milestones: ["Premier échange", "Validation du périmètre"],
  },
  {
    number: "02",
    title: "Concevoir et réaliser",
    description:
      "Contenus et direction visuelle sont préparés avant la production. Vous validez les choix structurants, puis le site est construit et contrôlé sur une préversion.",
    milestones: [
      "Contenus et direction",
      "Validation de l’expérience",
      "Vérification du site",
    ],
  },
  {
    number: "03",
    title: "Lancer et faire évoluer",
    description:
      "La mise en ligne intervient après votre accord et les vérifications finales. Vous recevez les informations nécessaires pour garder la maîtrise du site et décider d’éventuelles suites.",
    milestones: ["Mise en ligne et transmission", "Point de suivi"],
  },
] as const;
---

<BaseLayout
  title={`Méthode — ${brand.name}`}
  description="Trois phases et sept jalons pour concevoir un site web avec des décisions claires, des validations utiles et un périmètre maîtrisé."
>
  <div class="page-shell inner-page">
    <header class="page-intro">
      <p class="section-kicker">Méthode</p>
      <h1>Avancer ensemble, sans perdre le fil.</h1>
      <p>
        Vous savez ce qui se passe, ce que j’attends de vous et ce qui doit être
        validé avant l’étape suivante. Le calendrier et les paiements sont
        adaptés à chaque projet dans la proposition.
      </p>
    </header>
    <div class="phase-list">
      {phases.map(({ number, title, description, milestones }) => (
        <section class="phase" aria-labelledby={`phase-${number}`}>
          <span class="phase-number" aria-hidden="true">
            {number}
          </span>
          <div>
            <h2 id={`phase-${number}`}>{title}</h2>
            <p>{description}</p>
            <ol>
              {milestones.map((milestone) => (
                <li>{milestone}</li>
              ))}
            </ol>
          </div>
        </section>
      ))}
    </div>
    <section
      class="section-divider split-section"
      aria-labelledby="change-title"
    >
      <div>
        <p class="section-kicker">Garder le cap</p>
        <h2 id="change-title">
          Les changements se discutent, ils ne se subissent pas.
        </h2>
      </div>
      <div class="prose">
        <p>
          Une nouvelle idée peut améliorer le projet. Avant de l’ajouter, nous
          regardons ensemble son effet sur le contenu, le budget, le délai et la
          qualité. Les validations et paiements correspondent aux jalons définis
          dans l’accord, jamais à une décision surprise.
        </p>
      </div>
    </section>
    <section class="note-panel" aria-labelledby="tools-title">
      <div>
        <p class="section-kicker">Outils et responsabilité</p>
        <h2 id="tools-title">Les outils évoluent. Le jugement reste humain.</h2>
        <p>
          J’utilise l’IA, l’automatisation et les contrôles techniques quand ils
          améliorent le travail. Je choisis leur place, vérifie leurs
          propositions et reste responsable du résultat. Les informations
          confidentielles ne sont pas confiées à un outil sans cadre adapté.
        </p>
      </div>
      <a class="text-link" href="/a-propos/">
        Qui porte le projet ? <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</BaseLayout>
