---
import { brand } from "../config/brand";
import BaseLayout from "../layouts/BaseLayout.astro";

const phases = [
  {
    number: "01",
    title: "Comprendre et cadrer",
    description:
      "Nous parlons de votre activité, de vos objectifs et de vos contraintes. Une proposition écrite fixe ensuite le périmètre, les responsabilités et les conditions du projet.",
    milestones: ["Premier échange", "Validation du périmètre"],
    clientRole:
      "Partager votre connaissance de l’activité, vos contraintes et vos priorités, puis valider le périmètre proposé.",
    firstStep: 1,
    steps: [
      [
        "Clarifier votre projet",
        "Nous échangeons sur votre activité, vos objectifs, vos contraintes et vos attentes.",
        "Un brief et un périmètre précisant ce qui est inclus, exclu et attendu de chacun.",
      ],
      [
        "Comprendre vos visiteurs",
        "Nous identifions les personnes à qui le site s’adresse et les actions qu’elles doivent pouvoir accomplir facilement.",
        "Des besoins prioritaires, en distinguant les faits connus des hypothèses à vérifier.",
      ],
      [
        "Définir les priorités",
        "Nous précisons votre message, les contenus importants et les actions à mettre en avant.",
        "Une première version utile, sans fonctionnalités ajoutées uniquement parce qu’elles existent.",
      ],
      [
        "Vérifier la faisabilité",
        "J’évalue les solutions techniques, l’hébergement, les services nécessaires et leurs contraintes.",
        "Des choix expliqués, des coûts récurrents identifiés et des responsabilités clarifiées.",
      ],
    ],
  },
  {
    number: "02",
    title: "Concevoir et réaliser",
    description:
      "Contenus et direction visuelle sont préparés avant la production. Vous validez les choix structurants, puis le site est construit et contrôlé sur une préversion.",
    milestones: [
      "Contenus et direction",
      "Validation de l’expérience",
      "Vérification du site",
    ],
    clientRole:
      "Fournir les éléments convenus, partager des retours regroupés et valider les choix aux étapes prévues.",
    firstStep: 5,
    steps: [
      [
        "Préparer les contenus",
        "Nous recensons les textes, photos et informations nécessaires, ainsi que les droits d’utilisation.",
        "Une liste des contenus à fournir ou à produire, avec des responsabilités définies.",
      ],
      [
        "Organiser le site",
        "Nous construisons l’arborescence et les parcours pour aider les visiteurs à trouver l’information et à agir.",
        "Un plan du site et une navigation compréhensible.",
      ],
      [
        "Choisir la direction visuelle",
        "Nous travaillons les couleurs, les typographies, les images et l’ambiance, en tenant compte de votre identité existante.",
        "Une direction graphique argumentée. Une planche d’ambiance peut servir de support si elle est utile.",
      ],
      [
        "Structurer les pages",
        "Nous définissons la place des contenus et des actions, en commençant par les besoins sur mobile.",
        "Des schémas de pages, appelés wireframes, pour valider la structure avant les détails graphiques.",
      ],
      [
        "Concevoir les maquettes",
        "Nous appliquons la direction visuelle aux pages et aux éléments d’interface.",
        "Des maquettes représentatives, avec les comportements nécessaires au projet.",
      ],
      [
        "Vérifier les parcours",
        "Nous examinons si les actions importantes sont faciles à comprendre et à accomplir.",
        "Des ajustements fondés sur les difficultés observées, plutôt que sur les seules préférences esthétiques.",
      ],
      [
        "Développer et intégrer",
        "Je construis le site et intègre les contenus et fonctionnalités convenus.",
        "Une version consultable pour suivre l’avancement et préparer les vérifications.",
      ],
      [
        "Contrôler le résultat",
        "Je vérifie les contenus, liens, parcours, affichages et exigences techniques applicables.",
        "Une liste de vérifications et de corrections avant votre validation finale.",
      ],
    ],
  },
  {
    number: "03",
    title: "Lancer et faire évoluer",
    description:
      "La mise en ligne intervient après votre accord et les vérifications finales. Vous recevez les informations nécessaires pour garder la maîtrise du site et décider d’éventuelles suites.",
    milestones: ["Mise en ligne et transmission", "Point de suivi"],
    clientRole:
      "Donner votre accord de publication et confirmer les modalités de transmission et de suivi.",
    firstStep: 13,
    steps: [
      [
        "Valider avant publication",
        "Vous examinez la version prévue pour la mise en ligne. Nous clarifions les éventuelles réserves.",
        "Un accord explicite sur la version à publier et les points restant à traiter.",
      ],
      [
        "Mettre en ligne et vérifier",
        "Je réalise le déploiement autorisé, puis contrôle les pages et fonctions importantes sur le site publié.",
        "Un site en ligne vérifié, avec une procédure de retour à une version précédente adaptée au projet.",
      ],
      [
        "Transmettre et préparer la suite",
        "Nous organisons les accès, les documents et les modalités de suivi prévus.",
        "Une transmission claire et, si convenu, un cadre de maintenance et d’évolution.",
      ],
    ],
  },
] as const;
---

<BaseLayout
  title={`Méthode de création de sites web | ${brand.name}`}
  description="Découvrez les étapes de création de votre site web : cadrage, contenus, design, développement et mise en ligne, avec des validations claires."
>
  <div class="page-shell inner-page method-page">
    <header class="page-intro">
      <p class="section-kicker">Méthode</p>
      <h1>Avancer ensemble, sans perdre le fil.</h1>
      <p>
        Un site utile commence par une bonne compréhension de votre activité, de
        vos visiteurs et de vos objectifs. Je vous accompagne du premier échange
        à la mise en ligne, avec des étapes lisibles, des décisions expliquées
        et des validations au bon moment.
      </p>
    </header>
    <p class="method-context">
      Vous savez ce qui avance, ce qui reste à décider et ce dont j’ai besoin
      pour poursuivre. Le périmètre, les livrables, le calendrier et les
      modalités de paiement sont définis dans la proposition, avant le
      démarrage. Certaines étapes peuvent être regroupées ou se chevaucher : ce
      ne sont pas quinze rendez-vous ni quinze paiements obligatoires.
    </p>
    <div class="phase-list">
      {phases.map(
        ({
          number,
          title,
          description,
          milestones,
          clientRole,
          firstStep,
          steps,
        }) => (
          <section class="phase" aria-labelledby={`phase-${number}`}>
            <span class="phase-number" aria-hidden="true">
              {number}
            </span>
            <div class="method-phase-content">
              <h2 id={`phase-${number}`}>{title}</h2>
              <p>{description}</p>
              <ol class="method-milestones" aria-label={`Jalons : ${title}`}>
                {milestones.map((milestone) => (
                  <li>{milestone}</li>
                ))}
              </ol>
              <p class="method-client-role">
                <strong>Votre rôle :</strong> {clientRole}
              </p>
              <details class="method-disclosure">
                <summary>Explorer les étapes : {title}</summary>
                <ol class="method-steps" start={firstStep}>
                  {steps.map(([stepTitle, action, output], index) => (
                    <li data-method-step={firstStep + index}>
                      <h3>{stepTitle}</h3>
                      <p>{action}</p>
                      <p>
                        <strong>Ce qui en ressort :</strong> {output}
                      </p>
                    </li>
                  ))}
                </ol>
              </details>
            </div>
          </section>
        ),
      )}
    </div>
    <section
      class="section-divider split-section"
      aria-labelledby="example-title"
    >
      <div>
        <p class="section-kicker">Un exemple concret</p>
        <h2 id="example-title">Valider la structure avant de développer.</h2>
      </div>
      <div class="prose">
        <p>
          Pour un site d’artisan, nous vérifions d’abord que les visiteurs
          peuvent comprendre les prestations, identifier la zone d’intervention
          et trouver comment vous contacter.
        </p>
        <p>
          Vous validez cette organisation avant que je développe les pages en
          détail. Si une nouvelle prestation apparaît ensuite, nous évaluons
          ensemble son impact sur le travail, le budget et le calendrier.
        </p>
      </div>
    </section>
    <section
      class="section-divider split-section"
      aria-labelledby="change-title"
    >
      <div>
        <p class="section-kicker">Garder le cap</p>
        <h2 id="change-title">
          Les changements se discutent, ils ne se subissent pas.
        </h2>
      </div>
      <div class="prose">
        <p>
          Une nouvelle idée peut améliorer le projet. Avant de l’ajouter, nous
          regardons ensemble son effet sur le contenu, le budget, le délai et la
          qualité. Les validations et paiements correspondent aux jalons définis
          dans l’accord, jamais à une décision surprise.
        </p>
        <p>
          Nous distinguons une correction, un ajustement prévu et une nouvelle
          prestation. La maintenance reste une prestation définie, pas un
          accompagnement illimité automatiquement inclus.
        </p>
      </div>
    </section>
    <section
      class="section-divider split-section"
      aria-labelledby="tools-title"
    >
      <div>
        <p class="section-kicker">Outils et responsabilité</p>
        <h2 id="tools-title">Les outils évoluent. Le jugement reste humain.</h2>
      </div>
      <div class="prose">
        <p>
          L’utilisation de l’IA fait partie de mon savoir-faire : choisir les
          outils pertinents, formuler les bonnes demandes, comparer les
          propositions, les adapter et vérifier le résultat. Je l’utilise
          lorsque cela sert le projet, avec d’autres outils de conception, de
          développement et de contrôle. Les décisions et la qualité du travail
          livré restent sous ma responsabilité. Les informations confidentielles
          ne sont pas confiées à un outil sans cadre adapté.
        </p>
        <a class="text-link" href="/a-propos/">
          Qui porte le projet ? <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section
      class="section-divider split-section"
      aria-labelledby="quality-title"
    >
      <div>
        <h2 id="quality-title">
          La qualité se prépare tout au long du projet.
        </h2>
      </div>
      <div class="prose">
        <p>
          Lisibilité sur mobile, accessibilité, performance, référencement
          naturel, sécurité et protection des données sont pris en compte selon
          les besoins du site. Les vérifications réalisées et les éventuelles
          limites restent explicites.
        </p>
        <p>
          La méthode s’adapte à votre projet. Pour les petits sites, certaines
          étapes peuvent être combinées : un prototype interactif ou des
          maquettes très détaillées ne sont pas imposés s’ils n’aident pas à
          décider.
        </p>
        {brand.contactEmail ? (
          <a class="text-link" href={`mailto:${brand.contactEmail}`}>
            Parlons de votre projet
          </a>
        ) : (
          <a class="text-link" href="/services/">
            Découvrir les prestations
          </a>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .method-page {
    color: var(--color-ink);
    padding-block: clamp(2.5rem, 4vw, 4rem);
  }
  .method-page .page-intro {
    max-width: 100%;
    padding-bottom: var(--space-4);
  }
  .method-context {
    max-width: 70ch;
    margin-bottom: var(--space-4);
    color: var(--color-muted);
  }
  .method-page .page-intro h1 {
    max-width: 100%;
    font-size: clamp(2.7rem, 7vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.065em;
  }
  .method-page .phase {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: clamp(2rem, 4vw, 4rem);
  }
  .method-page .split-section {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  .method-page .section-divider {
    padding-block: clamp(2.5rem, 4vw, 4rem);
  }
  .method-page .split-section h2 {
    max-width: 100%;
  }
  .method-page .method-phase-content {
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
  }
  .method-page .phase h2 {
    max-width: none;
  }
  .method-page .phase p {
    max-width: 70ch;
  }
  .method-page .method-milestones {
    font-weight: 650;
  }
  .method-disclosure {
    min-width: 0;
    border-top: 1px solid var(--color-border);
  }
  .method-disclosure summary {
    padding-block: var(--space-3);
    cursor: pointer;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .method-disclosure summary:hover {
    color: var(--color-accent-dark);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .method-page :focus-visible {
    outline-color: var(--color-accent);
  }
  .method-page .method-steps {
    gap: var(--space-4);
    padding-inline-start: var(--space-3);
    font-weight: 400;
  }
  .method-steps li {
    padding-inline-start: var(--space-1);
  }
  .method-steps li::marker {
    color: var(--color-accent-dark);
    font-weight: 700;
  }
  .method-steps h3 {
    margin-bottom: var(--space-2);
  }
  .method-steps p + p {
    margin-top: var(--space-2);
  }
  @media (min-width: 45rem) {
    .method-page .phase {
      grid-template-columns: minmax(0, 0.12fr) minmax(0, 1fr);
      gap: var(--space-4);
    }
    .method-page .method-phase-content {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.65fr);
    }
    .method-client-role,
    .method-disclosure {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 62rem) {
    .method-page .split-section {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
    .method-page .method-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--space-6);
    }
  }
</style>
