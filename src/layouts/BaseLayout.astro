---
import { brand } from "../config/brand";
import { releaseChannelSchema, validateBrandForRelease } from "../domain/brand";
import { pageDescription, previewOnly } from "../domain/release-copy";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const releaseChannel = releaseChannelSchema.parse(
  import.meta.env.PUBLIC_RELEASE_CHANNEL ?? "preview",
);
const activeBrand = validateBrandForRelease(brand, releaseChannel);
const navigation = [
  { href: "/realisations/", label: "Réalisations" },
  { href: "/services/", label: "Services" },
  { href: "/methode/", label: "Méthode" },
  { href: "/a-propos/", label: "À propos" },
] as const;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={pageDescription(description, releaseChannel)}
    />
    <meta
      name="robots"
      content={
        releaseChannel === "preview" ? "noindex, nofollow" : "index, follow"
      }
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label={`${activeBrand.name} — accueil`}>
          <span class="brand-symbol" aria-hidden="true">
            B
          </span>
          <span class="brand-wordmark">
            <strong>{activeBrand.name}</strong>
            {activeBrand.isProvisional && <small>Nom de travail</small>}
          </span>
        </a>
        <nav class="site-nav" aria-label="Navigation principale">
          <ul>
            {navigation.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={currentPath === href ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>{activeBrand.name}</strong>
        <p>Des sites pensés avec vous, construits avec méthode.</p>
      </div>
      <div>
        <p>Responsable du projet : {activeBrand.founder}</p>
        {previewOnly(
          "Préversion privée — identité et contenus en cours de validation.",
          releaseChannel,
        ) && (
          <p>
            Préversion privée — identité et contenus en cours de validation.
          </p>
        )}
      </div>
    </footer>
  </body>
</html>
